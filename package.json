{
  "name": "rulebook-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A simple AI workbench for reviewing boardgame rulebook translations",
  "scripts": {
    "start": "concurrently -k -n server,app -c blue,green \"npm:dev:server\" \"npm:start:client\"",
    "dev": "concurrently -k -n server,app -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:client": "vite",
    "start:client": "vite --open",
    "build": "vite build && tsc -p tsconfig.server.json",
    "serve": "NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.286",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
